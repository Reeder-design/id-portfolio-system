# Copying this file is not required; portfolio-manager/setup.py creates .env for you.
# Never commit the real .env file.

PORTFOLIO_MANAGER_SECRET_KEY=generated-locally-by-setup.py
PORTFOLIO_MANAGER_PASSWORD_HASH=generated-locally-by-setup.py

# Optional AI Assistance. Configure locally with:
#   python portfolio-manager/configure-ai.py
# OpenAI API billing is separate from a ChatGPT subscription.
OPENAI_API_KEY=generated-locally-or-add-your-own-key
PORTFOLIO_MANAGER_AI_MODEL=gpt-5.6-terra
