{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reeder-design.github.io/id-portfolio-system/schema/project.schema.json",
  "title": "Portfolio Project",
  "description": "Structured source data for a public portfolio project.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "slug",
    "category",
    "status",
    "summary",
    "page_path",
    "confidentiality",
    "featured",
    "content",
    "skills",
    "tools",
    "assets",
    "dates"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "category": {
      "type": "string",
      "enum": [
        "instructional-design",
        "ai-training-and-evaluation",
        "lms-administration",
        "workflows"
      ]
    },
    "subcategory": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "live",
        "building",
        "planned",
        "archived"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "page_path": {
      "type": "string",
      "pattern": "^portfolio/projects/.+/index\\.html$"
    },
    "featured": {
      "type": "boolean"
    },
    "confidentiality": {
      "type": "string",
      "enum": [
        "public",
        "sanitized",
        "needs-sanitization"
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "business_need",
        "audience",
        "learning_objectives",
        "role",
        "design_approach",
        "development_process",
        "outcomes"
      ],
      "properties": {
        "business_need": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "learning_objectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "role": {
          "type": "string"
        },
        "design_approach": {
          "type": "string"
        },
        "development_process": {
          "type": "string"
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "detail_sections": {
      "type": "array",
      "description": "Optional reusable sections that add project-specific depth without changing the standard project page type.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "eyebrow",
          "title",
          "layout"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "eyebrow": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "layout": {
            "type": "string",
            "enum": [
              "cards",
              "flow",
              "table"
            ]
          },
          "show_in_nav": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                },
                "tag": {
                  "type": "string"
                }
              }
            }
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "items"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "related_work": {
      "type": "array",
      "description": "Optional connections to other structured portfolio projects.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project_id",
          "relationship"
        ],
        "properties": {
          "project_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "relationship": {
            "type": "string"
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "live_project": {
          "type": [
            "string",
            "null"
          ]
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "download": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "path",
          "publish"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "image",
              "video",
              "pdf",
              "document",
              "download",
              "embed",
              "code",
              "other"
            ]
          },
          "path": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          },
          "publish": {
            "type": "boolean"
          }
        }
      }
    },
    "source_material_notes": {
      "type": "string",
      "description": "Notes about private/reference source material. Do not store confidential source files in this public repository."
    },
    "dates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created",
        "updated"
      ],
      "properties": {
        "created": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "updated": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "component_refs": {
      "type": "array",
      "uniqueItems": true,
      "description": "Optional reusable-component registry IDs intentionally associated with this project. These document design-system usage and do not inject markup into custom pages.",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  }
}
